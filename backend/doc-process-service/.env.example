# 环境配置
ENVIRONMENT=development

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=2
SERVER_TIMEOUT=300

# 数据库配置
DATABASE_URL=postgresql://admin:password@localhost:5432/docu_sage
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_MIN_IDLE_CONNECTIONS=5
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_TLS_ENABLED=false
REDIS_TLS_VERIFY_MODE=CERT_NONE

# Milvus配置
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=document_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_TLS_ENABLED=false
MILVUS_TIMEOUT=30
MILVUS_MAX_RETRIES=3

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=docu-sage
MINIO_REGION=us-east-1
MINIO_PART_SIZE=10485760

# 嵌入服务配置
EMBEDDING_API_URL=http://embedding-service:8000/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=768

# Kafka配置
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCUMENT_UPLOAD=document-upload
KAFKA_TOPIC_CHUNK_PROCESS=chunk-process
KAFKA_TOPIC_EMBEDDING_GENERATE=embedding-generate

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']

# 文件处理配置
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,csv,xlsx,pptx,md
TEMP_FILE_DIR=/tmp
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# 性能配置
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# CORS配置
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# 安全配置
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# 监控配置
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=false