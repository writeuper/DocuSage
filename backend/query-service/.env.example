# 服务器配置
SERVER_PORT=8082
SERVER_HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=query_service

# Redis配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production

# 向量搜索服务配置
VECTOR_SEARCH_SERVICE_ADDR=http://localhost:8087

# 文档处理服务配置
DOC_PROCESS_SERVICE_ADDR=http://localhost:8088

# 嵌入服务配置
EMBED_SERVICE_ADDR=http://localhost:8089

# LLM服务配置
LLM_SERVICE_ADDR=http://localhost:8090

# 搜索配置
MAX_SEARCH_RESULTS=100
DEFAULT_SEARCH_LIMIT=10
SEARCH_HISTORY_MAX_ITEMS=100

# 日志配置
LOG_LEVEL=info

# 环境配置
ENVIRONMENT=development